# Copy to .env.local (gitignored). Never commit real keys.
#
# Optional. Google Map Tiles API key for Photorealistic 3D Tiles. When missing or invalid the
# app automatically falls back to an OpenStreetMap raster globe and shows a banner.
# Google tiles are used for DISPLAY ONLY. They are never a data source for the simulation.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. Gemini API key for the "Suggest a plan with Gemini" button (Google AI Studio).
# Without it a simple built-in planner is used. Vite puts VITE_* values in the browser bundle,
# so use a key restricted to the Generative Language API and to your deploy domain.
VITE_GEMINI_API_KEY=
# Model id, e.g. the one given at the hackathon. Default: gemini-2.5-flash
VITE_GEMINI_MODEL=
