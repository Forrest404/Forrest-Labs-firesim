# Copy to .env.local (gitignored). Never commit real keys.
#
# Optional. Google Map Tiles API key for Photorealistic 3D Tiles. When missing or invalid the
# app automatically falls back to an OpenStreetMap raster globe and shows a banner.
# Google tiles are used for DISPLAY ONLY. They are never a data source for the simulation.
VITE_GOOGLE_MAPS_API_KEY=
